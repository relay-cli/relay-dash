{
  "name": "@relay-cli/dash",
  "version": "0.1.0",
  "description": "A terminal dashboard for pack-sentinel findings and impossibleG service status: models, queues, and health.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "keywords": [
    "cli",
    "dashboard",
    "ink",
    "monitoring",
    "react",
    "terminal-ui",
    "tui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/relay-cli/relay-dash.git"
  },
  "bugs": {
    "url": "https://github.com/relay-cli/relay-dash/issues"
  },
  "homepage": "https://github.com/relay-cli/relay-dash#readme",
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "relay-dash": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "eslint": "^10.11.0",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
